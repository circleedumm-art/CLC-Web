rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'your-admin-gmail@gmail.com'   // <- same email as ADMIN_EMAIL
        && request.auth.token.email_verified == true;
    }

    // Guests may only ADD a pending enrolment. They can never read, change or delete anything.
    match /enrolments/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name','email','course','note','status','createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() <= 150
        && request.resource.data.note is string && request.resource.data.note.size() <= 500
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // Public website content: anyone can read, only the admin can change (admin rule below).
    match /programs/{id} { allow read: if true; }
    match /publicSchedule/{id} { allow read: if true; }

    // Everything else: admin only (students/teachers get their own rules in later steps).
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
