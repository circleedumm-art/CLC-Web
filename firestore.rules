rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers ----------------------------------------------------------
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'circle.edu.mm@gmail.com'   // <- same email as ADMIN_EMAIL
        && request.auth.token.email_verified == true;
    }
    function signedIn() { return request.auth != null; }
    // Inactive accounts cannot read anything except their own profile document.
    function active() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') != 'inactive';
    }
    function inClass(classId) {
      return signedIn() && active()
        && exists(/databases/$(database)/documents/memberships/$(classId + '_' + request.auth.uid));
    }
    function teaches(classId) {
      return signedIn() && active()
        && get(/databases/$(database)/documents/classes/$(classId)).data.teacherId == request.auth.uid;
    }
    // Teachers may change these fields on their own classes (links stay private to the class).
    function classFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['day', 'time', 'sessions', 'tz', 'venue_en', 'venue_my', 'level', 'telegramUrl', 'zoomUrl', 'updatedAt'])
        && httpsOrEmpty(request.resource.data.get('telegramUrl', ''))
        && httpsOrEmpty(request.resource.data.get('zoomUrl', ''))
        && request.resource.data.get('level', '') in ['', 'A1', 'A2', 'B1', 'B2', 'C1', 'C2'];
    }
    // Only these fields are ever public.
    function publicFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['day', 'time', 'sessions', 'tz', 'venue_en', 'venue_my', 'level']);
    }
    function httpsOrEmpty(v) { return v == '' || (v is string && v.matches('^https://.{3,500}$')); }

    // ---- Guests -----------------------------------------------------------
    // Guests may only ADD a pending enrolment. They can never read, change or delete anything.
    match /enrolments/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name','email','course','note','status','createdAt','scholarship','essay'])
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.course is string && request.resource.data.course.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() <= 150
        && request.resource.data.note is string && request.resource.data.note.size() <= 500
        && request.resource.data.get('scholarship', 'none') in ['none', 'half', 'full']
        && request.resource.data.get('essay', '') is string && request.resource.data.get('essay', '').size() <= 3000
        && (request.resource.data.get('scholarship', 'none') == 'none' || request.resource.data.get('essay', '').size() >= 20)
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // ---- Students and teachers -------------------------------------------
    // Everyone can read their own profile and change only these fields.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid && active()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone', 'location', 'about', 'updatedAt']);
    }

    // Students: their own memberships. Teachers: memberships of classes they teach.
    match /memberships/{id} {
      allow read: if (signedIn() && active() && resource.data.studentId == request.auth.uid)
                  || teaches(resource.data.classId);
    }

    // Students can open classes they belong to. Teachers can list their own classes
    // and change only the day, time and place.
    match /classes/{id} {
      allow get: if inClass(id) || (signedIn() && active() && resource.data.teacherId == request.auth.uid);
      allow list: if signedIn() && active() && resource.data.teacherId == request.auth.uid;
      allow update: if signedIn() && active() && resource.data.teacherId == request.auth.uid && classFieldsOnly();
    }

    match /exams/{id} {
      allow read: if inClass(resource.data.classId) || teaches(resource.data.classId);
      allow create: if teaches(request.resource.data.classId)
        && request.resource.data.keys().hasOnly(['classId','title','date','time','venue','link'])
        && httpsOrEmpty(request.resource.data.get('link', ''))
        && request.resource.data.title is string && request.resource.data.title.size() <= 120;
      allow delete: if teaches(resource.data.classId);
    }

    match /grades/{id} {
      allow read: if (signedIn() && active() && resource.data.studentId == request.auth.uid)
                  || teaches(resource.data.classId);
      allow create: if teaches(request.resource.data.classId)
        && exists(/databases/$(database)/documents/memberships/$(request.resource.data.classId + '_' + request.resource.data.studentId))
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && request.resource.data.score is number && request.resource.data.max is number
        && request.resource.data.max > 0 && request.resource.data.score >= 0
        && request.resource.data.score <= request.resource.data.max;
      allow delete: if teaches(resource.data.classId);
    }

    // Attendance is written and read by the class teacher only (and the admin).
    match /attendance/{id} {
      allow read: if teaches(resource.data.classId);
      allow create, update: if teaches(request.resource.data.classId)
        && request.resource.data.keys().hasOnly(['classId','date','records','teacherId','updatedAt'])
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.date is string && request.resource.data.date.size() == 10
        && request.resource.data.records is map
        && id == request.resource.data.classId + '_' + request.resource.data.date;
    }

    // Per-student attendance entries: a student sees only their own; the class teacher sees the class.
    match /attendanceEntries/{id} {
      allow read: if (signedIn() && active() && resource.data.studentId == request.auth.uid)
                  || teaches(resource.data.classId);
      allow create, update: if teaches(request.resource.data.classId)
        && request.resource.data.keys().hasOnly(['classId','date','studentId','status'])
        && request.resource.data.status in ['present','late','absent','excused']
        && request.resource.data.date is string && request.resource.data.date.size() == 10
        && exists(/databases/$(database)/documents/memberships/$(request.resource.data.classId + '_' + request.resource.data.studentId))
        && id == request.resource.data.classId + '_' + request.resource.data.date + '_' + request.resource.data.studentId;
    }

    // Class materials are links added by the teacher; only class members and the teacher can read them.
    match /materials/{id} {
      allow read: if inClass(resource.data.classId) || teaches(resource.data.classId);
      allow create: if teaches(request.resource.data.classId)
        && request.resource.data.keys().hasOnly(['classId','title','url','createdAt'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 150
        && request.resource.data.url is string && request.resource.data.url.matches('^https://.{3,500}$');
      allow delete: if teaches(resource.data.classId);
    }

    // Teacher profile shown to students: name, intro and intro-video link only (no phone or email).
    match /teacherProfiles/{uid} {
      allow read: if signedIn() && active();
      allow create, update: if signedIn() && active() && request.auth.uid == uid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher'
        && request.resource.data.keys().hasOnly(['name','about','introVideo','updatedAt'])
        && request.resource.data.about.size() <= 1000
        && httpsOrEmpty(request.resource.data.introVideo);
    }

    // Messages between a student and their class teacher (not real time).
    match /messages/{id} {
      allow read: if signedIn() && active()
        && (resource.data.studentId == request.auth.uid || resource.data.teacherId == request.auth.uid);
      allow create: if signedIn() && active()
        && request.resource.data.keys().hasOnly(['classId','studentId','teacherId','from','text','createdAt'])
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
        && request.resource.data.createdAt == request.time
        && (
          (request.resource.data.from == 'student' && request.resource.data.studentId == request.auth.uid
            && inClass(request.resource.data.classId)
            && get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.teacherId == request.resource.data.teacherId)
          ||
          (request.resource.data.from == 'teacher' && request.resource.data.teacherId == request.auth.uid
            && teaches(request.resource.data.classId)
            && exists(/databases/$(database)/documents/memberships/$(request.resource.data.classId + '_' + request.resource.data.studentId)))
        );
    }

    // Reports to the admin. The sender can read their own reports and the admin's reply.
    match /reports/{id} {
      allow read: if signedIn() && resource.data.fromUid == request.auth.uid;
      allow create: if signedIn() && active()
        && request.resource.data.keys().hasOnly(['fromUid','fromName','fromRole','loginId','subject','text','status','createdAt'])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.fromRole == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        && request.resource.data.status == 'new'
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
        && request.resource.data.createdAt == request.time;
    }

    // A student writes ONE review per completed class (needed before the certificate opens in the portal).
    // Reviews are private: only the author and the admin can read them.
    match /reviews/{id} {
      allow read: if signedIn() && resource.data.studentId == request.auth.uid;
      allow create: if signedIn() && active()
        && request.resource.data.keys().hasOnly(['classId','programId','studentId','studentName','rating','text','allowPublic','status','createdAt'])
        && request.resource.data.studentId == request.auth.uid
        && id == request.resource.data.classId + '_' + request.auth.uid
        && get(/databases/$(database)/documents/memberships/$(id)).data.status == 'completed'
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.text is string && request.resource.data.text.size() >= 10 && request.resource.data.text.size() <= 1000
        && request.resource.data.allowPublic is bool
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
    }

    // ---- Public website content ------------------------------------------
    match /programs/{id} { allow read: if true; }
    // Approved student testimonials (first name only, copied here by the admin) and the "how to use" video links.
    match /testimonials/{id} { allow read: if true; }
    match /siteContent/{id} { allow read: if true; }
    match /publicSchedule/{id} {
      allow read: if true;
      allow update: if teaches(id) && publicFieldsOnly();   // keeps the public timetable in step with a teacher's change
    }

    // ---- Everything else: admin only -------------------------------------
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
